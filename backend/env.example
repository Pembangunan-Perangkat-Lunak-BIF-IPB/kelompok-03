# Salin menjadi .env lalu sesuaikan
DATABASE_URL=postgresql://postgres:106006@localhost:5432/human_gvc
SECRET_KEY=QWERTY
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_DIR=./storage

# simulasi = pipeline tiruan (demo/uji, tanpa tool) | nyata = fastp, bwa, samtools, bcftools
PIPELINE_MODE=simulasi
SIM_DETIK_PER_TAHAP=4
PIPELINE_THREADS=4
PIPELINE_WORKERS=2
MAX_UPLOAD_MB=2048

# --- Email (verifikasi akun & lupa kata sandi) ---
# Kosongkan SMTP_HOST untuk mode pengembangan: isi email (termasuk tautan) dicetak di TERMINAL backend, tidak ada email terkirim.
# Untuk Gmail: aktifkan Verifikasi 2 Langkah, buat "App Password" (16 karakter), lalu isi di bawah (tanpa spasi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dhafinfasya@gmail.com
SMTP_PASSWORD=pvsl bpud mpwb qwfs
SMTP_FROM=dhafinfasya@gmail.com
# Dasar tautan di email (alamat frontend yang dibuka pengguna)
APP_URL=http://localhost:3000
VERIFIKASI_JAM=24
RESET_MENIT=60
# Batas percobaan per 15 menit (per IP): daftar / kirim ulang / lupa sandi, dan login
RATE_LIMIT_MAKS=5
RATE_LIMIT_LOGIN_MAKS=10
